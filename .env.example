# Copiá este archivo como ".env" y completalo con tus datos reales.
#
# IMPORTANTE: el archivo ".env" (sin ".example") va UN NIVEL ARRIBA de
# public_html, es decir en la raíz de tu cuenta de Hostinger — NO adentro
# de public_html. Así el navegador nunca puede acceder a él y, aunque
# vuelvas a compartir la carpeta public_html (zip, git, email), tu
# contraseña real no viaja adentro.
#
# Cómo subirlo en Hostinger (Administrador de archivos de hPanel):
#   1. Andá a Archivos > Administrador de archivos.
#   2. Subí un nivel: de "public_html" a la carpeta de arriba (tu home).
#   3. Creá un archivo nuevo llamado ".env" ahí (al lado de la carpeta
#      public_html, no adentro).
#   4. Pegá este contenido y completá con tus 4 datos reales de MySQL
#      (hPanel > Bases de datos > MySQL).

DB_HOST=localhost
DB_NAME=tu_basededatos
DB_USER=tu_usuario
DB_PASS=tu_contraseña_real
DB_CHARSET=utf8mb4

# Opcional (Google reCAPTCHA)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
