RewriteEngine On

# Fuerza HTTPS: si alguien entra por http://, lo redirige a https://
# Así el login/registro nunca viaja la contraseña sin cifrar por la red.
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Bloquea el acceso directo por navegador a carpetas internas
RewriteRule ^(includes|sql)/ - [F,L]

# Red de seguridad: si el .env (o el .env.example) queda dentro de
# public_html por error, igual bloquea el acceso web directo.
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# No listar directorios
Options -Indexes
